+// 0-SMEM warp-register unpack of 1024 ternary trits into 8 packed u8 regs (values 0, 1, 2; mean offset 1 via isum).
+static __device__ __forceinline__ void ptq1_sb_warp_unpack_regs(
+        const ptq1_sb_raw_bq & b, const int lane, int * w_reg) {
+    const uint32_t sh       = b.off * 8u;
+    const uint32_t lo1_next = __shfl_sync(0xFFFFFFFFu, b.lo1, (lane + 1) & 31);
+    const uint32_t lo2_0    = __shfl_sync(0xFFFFFFFFu, b.lo2, 0);
+    const uint32_t hi1      = (lane == 31) ? lo2_0 : lo1_next;
+    const uint32_t my_w_lo  = b.off ? __funnelshift_r(b.lo1, hi1, sh) : b.lo1;
+
+    const uint32_t lo2_next = __shfl_sync(0xFFFFFFFFu, b.lo2, (lane + 1) & 31);
+    const uint32_t my_w_hi  = (lane >= 18) ? b.tail : (b.off ? __funnelshift_r(b.lo2, lo2_next, sh) : b.lo2);
+
+    const int      e0   = lane * 32;
+    const int      b0   = e0 / 5;
+    const int      rem0 = e0 - b0 * 5;
+    const int      sw   = b0 >> 2;
+    const int      sl0  = sw & 31;
+    const int      sl1  = (sw + 1) & 31;
+    const int      sl2  = (sw + 2) & 31;
+    const uint32_t bo   = (uint32_t) ((b0 & 3) * 8);
+
+    const uint32_t lo0  = __shfl_sync(0xFFFFFFFFu, my_w_lo, sl0);
+    const uint32_t lo1  = __shfl_sync(0xFFFFFFFFu, my_w_lo, sl1);
+    const uint32_t lo2  = __shfl_sync(0xFFFFFFFFu, my_w_lo, sl2);
+    const uint32_t hi0  = __shfl_sync(0xFFFFFFFFu, my_w_hi, sl0);
+    const uint32_t hi1w = __shfl_sync(0xFFFFFFFFu, my_w_hi, sl1);
+    const uint32_t hi2w = __shfl_sync(0xFFFFFFFFu, my_w_hi, sl2);
+
+    const uint32_t w0 = (lane < 20) ? lo0 : hi0;
+    const uint32_t w1 = (lane < 20) ? lo1 : hi1w;
+    const uint32_t w2 = (lane < 19) ? lo2 : hi2w;
+
+    const uint32_t p_lo = bo ? __funnelshift_r(w0, w1, bo) : w0;
+    const uint32_t p_hi = bo ? __funnelshift_r(w1, w2, bo) : w1;
+
+    uint32_t t0, t1, t2, t3, t4, t5, t6, unused;
+    const uint32_t u0 = ptq1_sb_unpack_u32(p_lo & 0xFFu,         t0);
+    const uint32_t u1 = ptq1_sb_unpack_u32((p_lo >> 8) & 0xFFu,  t1);
+    const uint32_t u2 = ptq1_sb_unpack_u32((p_lo >> 16) & 0xFFu, t2);
+    const uint32_t u3 = ptq1_sb_unpack_u32(p_lo >> 24,           t3);
+    const uint32_t u4 = ptq1_sb_unpack_u32(p_hi & 0xFFu,         t4);
+    const uint32_t u5 = ptq1_sb_unpack_u32((p_hi >> 8) & 0xFFu,  t5);
+    const uint32_t u6 = ptq1_sb_unpack_u32((p_hi >> 16) & 0xFFu, t6);
+    const uint32_t u7 = ptq1_sb_unpack_u32(p_hi >> 24,           unused);
+
+    const uint32_t r[9] = {
+        u0,
+        t0 | (u1 << 8),
+        (u1 >> 24) | (t1 << 8) | (u2 << 16),
+        (u2 >> 16) | (t2 << 16) | (u3 << 24),
+        (u3 >> 8)  | (t3 << 24),
+        u4,
+        t4 | (u5 << 8),
+        (u5 >> 24) | (t5 << 8) | (u6 << 16),
+        (u6 >> 16) | (t6 << 16) | ((u7 & 0xFFu) << 24),
+    };
+
+    const uint32_t rsh = (uint32_t) (rem0 * 8);
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+        if (rem0 == 4) {
+            w_reg[k] = (int) r[k + 1];
+        } else {
+            w_reg[k] = (int) (rsh ? __funnelshift_r(r[k], r[k + 1], rsh) : r[k]);
+        }
+    }
+}
+
+static __device__ __forceinline__ float ptq1_sb_dp4a_slice(
+        const int * w_reg, const uint4 * slice, const int lane, const float d_sb) {
+    const half2 ds   = ((const half2 *) (slice + 64))[lane];
+    const float d8   = __low2float(ds);
+    const int   sumu = (int) __half_as_short(__high2half(ds));
+    const uint4 p0   = slice[lane];
+    const uint4 p1   = slice[32 + lane];
+    int sumi = 0;
+    sumi = ggml_cuda_dp4a(w_reg[0], (int) p0.x, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[1], (int) p0.y, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[2], (int) p0.z, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[3], (int) p0.w, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[4], (int) p1.x, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[5], (int) p1.y, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[6], (int) p1.z, sumi);
+    sumi = ggml_cuda_dp4a(w_reg[7], (int) p1.w, sumi);
+    return d_sb * d8 * (float) (sumi - sumu);
+}
