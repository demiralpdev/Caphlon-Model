+// Zero-SMEM, zero-__syncwarp() PTQ1_SB mat-vec consuming native GGML_CUDA_Q8_1_SB directly.
+// Block: (32, 4) — each warp processes 1 independent row asynchronously across kbx.
+template <int ncols_dst, bool has_fusion, bool has_gate>
+__launch_bounds__(128)
+static __global__ void mul_mat_vec_ptq1_sb_fast(
+        const void * __restrict__ vx, const uint4 * __restrict__ vy_sb,
+        const ggml_cuda_mm_fusion_args_device fusion, float * __restrict__ dst,
+        const int ncols_x, const int nrows_x,
