+// Shared-activation DP4A tiled kernel for PTQ1_SB prefill (ncols_dst = 17..512): avoids F16 dequant + cuBLAS.
+template <int J_TILE, int NWARPS>
+__launch_bounds__(32 * NWARPS)
+static __global__ void mul_mat_ptq1_sb_tiled_kernel(
+        const void * __restrict__ vx, const uint4 * __restrict__ vy_sb, float * __restrict__ dst,
+        const int blocks_per_row_x, const int nrows_x, const int ncols_dst,
+        const int stride_row_x, const int stride_sb_y, const int stride_col_dst) {
+    const int  lane       = (int) threadIdx.x;
+    const int  warp       = (int) threadIdx.y;
+    const int  row        = (int) blockIdx.x * NWARPS + warp;
+    const int  col0       = (int) blockIdx.y * J_TILE;
+    const int  ncols_tile = min(J_TILE, ncols_dst - col0);
+    const bool full_tile  = (col0 + J_TILE <= ncols_dst);
+
+    __shared__ __align__(16) uint4 sh_y[J_TILE][72];
+
+    float acc[J_TILE] = { 0.0f };
+    const block_ptq1_sb * row_x = (row < nrows_x) ? ((const block_ptq1_sb *) vx + (int64_t) row * stride_row_x) : nullptr;
+    ptq1_sb_raw_bq cur{};
+    if (row < nrows_x && blocks_per_row_x > 0) {
+        cur = ptq1_sb_prefetch_bq(row_x, lane);
+    }
+
+    for (int kbx = 0; kbx < blocks_per_row_x; ++kbx) {
+        if (kbx > 0) {
+            __syncthreads();
+        }
+        for (int j = warp; j < ncols_tile; j += NWARPS) {
+            const uint4 * src_blk = vy_sb + ((int64_t) (col0 + j) * stride_sb_y + kbx) * 72;
+            sh_y[j][lane]      = src_blk[lane];
+            sh_y[j][32 + lane] = src_blk[32 + lane];
+            if (lane < 8) {
+                sh_y[j][64 + lane] = src_blk[64 + lane];
+            }
+        }
+        __syncthreads();
+
+        if (row < nrows_x) {
+            int w_reg[8];
+            ptq1_sb_warp_unpack_regs(cur, lane, w_reg);
+            const float d_sb = cur.d_sb;
+            if (kbx + 1 < blocks_per_row_x) {
+                cur = ptq1_sb_prefetch_bq(row_x + kbx + 1, lane);
+            }
+            if (full_tile) {
+#pragma unroll
+                for (int j = 0; j < J_TILE; ++j) {
+                    acc[j] += ptq1_sb_dp4a_slice(w_reg, sh_y[j], lane, d_sb);
+                }
+            } else {
+                for (int j = 0; j < ncols_tile; ++j) {
+                    acc[j] += ptq1_sb_dp4a_slice(w_reg, sh_y[j], lane, d_sb);
+                }
+            }
+        }
+    }
+
+    if (row < nrows_x) {
+#pragma unroll
+        for (int j = 0; j < J_TILE; ++j) {
+            acc[j] = warp_reduce_sum<32>(acc[j]);
+        }
+        if (lane == 0) {
+            for (int j = 0; j < ncols_tile; ++j) {
+                dst[(int64_t) (col0 + j) * stride_col_dst + row] = acc[j];
+            }
+        }
+    }
+}
