+inline float ptq1_sb_sub_scale(device const block_ptq1_sb * xb, short sb) {
+    const ushort d_bits = (ushort) xb->d[0] | ((ushort) xb->d[1] << 8);
+    const float d = (float) as_type<half>(d_bits);
+    const uchar q = (xb->scales[sb >> 1] >> (4 * (sb & 1))) & 0xF;
+    if (q == 0) {
+        return 0.35f * d;
+    }
+    return (0.60f + ((float) (q - 1) / 14.0f) * 0.40f) * d;
+}
+
+inline float ptq1_sb_elem(device const block_ptq1_sb * xb, int e) {
+    const uchar b = xb->qs[e / 5];
+    const short n = e % 5;
+    return (float) ((int) ((ptq1_0_lut[b] >> (2 * n)) & 3) - 1);
+}
+
+template <typename type4x4>
+void dequantize_ptq1_sb(device const block_ptq1_sb * xb, short il, thread type4x4 & reg) {
+    const float ds = ptq1_sb_sub_scale(xb, il >> 3);
+    const int base = il * 16;
+    short bi = base / 5;
+    short n  = base % 5;
+    ushort lut = ptq1_0_lut[xb->qs[bi]];
+    float4x4 reg_f;
+    FOR_UNROLL (short j = 0; j < 16; ++j) {
+        reg_f[j / 4][j % 4] = (float) ((int) ((lut >> (2 * n)) & 3) - 1) * ds;
+        if (j < 15 && ++n == 5) {
+            n = 0;
+            lut = ptq1_0_lut[xb->qs[++bi]];
+        }
+    }
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4>
+void dequantize_ptq1_sb_t4(device const block_ptq1_sb * xb, short il, thread type4 & reg) {
+    const float ds = ptq1_sb_sub_scale(xb, il >> 5);
+    const int base = il * 4;
+    float4 reg_f;
+    FOR_UNROLL (short j = 0; j < 4; ++j) {
+        reg_f[j] = ptq1_sb_elem(xb, base + j) * ds;
+    }
+    reg = (type4) reg_f;
+}
