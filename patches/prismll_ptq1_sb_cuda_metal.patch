+// 2-row-per-warp zero-SMEM kernel for batch sizes 1..16 (non-gate projections):
+// issues 2 independent PTQ1_SB block prefetches per warp step and reuses each Q8_1_SB activation slice across 2 rows.
+template <int ncols_dst>
+__launch_bounds__(128)
+static __global__ void mul_mat_vec_ptq1_sb_fast_2row(
+        const void * __restrict__ vx, const uint4 * __restrict__ vy_sb,
+        const float * __restrict__ x_bias, float * __restrict__ dst,
+        const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int stride_sb_y, const int stride_col_dst) {
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int nwarps    = 4;
+
+    const int warp = (int) threadIdx.y;
+    const int row0 = (int) blockIdx.x * (nwarps * 2) + warp * 2;
+    if (row0 >= nrows_x) {
+        return;
+    }
+    const int  row1 = row0 + 1;
+    const bool has1 = row1 < nrows_x;
+    const int  lane = (int) threadIdx.x;
+    const int  blocks_per_row_x = ncols_x / QK_PTQ1_SB;
+
+    float tmp0[ncols_dst] = { 0.0f };
+    float tmp1[ncols_dst] = { 0.0f };
+
+    const block_ptq1_sb * rx0 = (const block_ptq1_sb *) vx + (int64_t) row0 * stride_row_x;
+    const block_ptq1_sb * rx1 = has1 ? ((const block_ptq1_sb *) vx + (int64_t) row1 * stride_row_x) : rx0;
+
+    ptq1_sb_raw_bq cur0 = ptq1_sb_prefetch_bq(rx0, lane);
+    ptq1_sb_raw_bq cur1 = ptq1_sb_prefetch_bq(rx1, lane);
+
+    for (int kbx = 0; kbx < blocks_per_row_x; ++kbx) {
+        int w0[8], w1[8];
+        const float d0 = cur0.d_sb;
+        const float d1 = cur1.d_sb;
+
+        ptq1_sb_warp_unpack_regs(cur0, lane, w0);
+        if (kbx + 1 < blocks_per_row_x) {
+            cur0 = ptq1_sb_prefetch_bq(rx0 + kbx + 1, lane);
+        }
+        ptq1_sb_warp_unpack_regs(cur1, lane, w1);
+        if (kbx + 1 < blocks_per_row_x) {
+            cur1 = ptq1_sb_prefetch_bq(rx1 + kbx + 1, lane);
+        }
+
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            const uint4 * slice = vy_sb + ((int64_t) j * stride_sb_y + kbx) * 72;
+            const half2 ds   = ((const half2 *) (slice + 64))[lane];
+            const float d8   = __low2float(ds);
+            const int   sumu = (int) __half_as_short(__high2half(ds));
+            const uint4 p0   = slice[lane];
+            const uint4 p1   = slice[32 + lane];
+            int s0 = 0, s1 = 0;
+            s0 = ggml_cuda_dp4a(w0[0], (int) p0.x, s0); s1 = ggml_cuda_dp4a(w1[0], (int) p0.x, s1);
+            s0 = ggml_cuda_dp4a(w0[1], (int) p0.y, s0); s1 = ggml_cuda_dp4a(w1[1], (int) p0.y, s1);
+            s0 = ggml_cuda_dp4a(w0[2], (int) p0.z, s0); s1 = ggml_cuda_dp4a(w1[2], (int) p0.z, s1);
+            s0 = ggml_cuda_dp4a(w0[3], (int) p0.w, s0); s1 = ggml_cuda_dp4a(w1[3], (int) p0.w, s1);
+            s0 = ggml_cuda_dp4a(w0[4], (int) p1.x, s0); s1 = ggml_cuda_dp4a(w1[4], (int) p1.x, s1);
+            s0 = ggml_cuda_dp4a(w0[5], (int) p1.y, s0); s1 = ggml_cuda_dp4a(w1[5], (int) p1.y, s1);
+            s0 = ggml_cuda_dp4a(w0[6], (int) p1.z, s0); s1 = ggml_cuda_dp4a(w1[6], (int) p1.z, s1);
+            s0 = ggml_cuda_dp4a(w0[7], (int) p1.w, s0); s1 = ggml_cuda_dp4a(w1[7], (int) p1.w, s1);
+            tmp0[j] += d0 * d8 * (float) (s0 - sumu);
+            tmp1[j] += d1 * d8 * (float) (s1 - sumu);
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+        tmp0[j] = warp_reduce_sum<warp_size>(tmp0[j]);
+        tmp1[j] = warp_reduce_sum<warp_size>(tmp1[j]);
+    }
+    if (lane == 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+            const int64_t off0 = (int64_t) j * stride_col_dst + row0;
+            float r0 = tmp0[j];
+            if (x_bias != nullptr) {
+                r0 += x_bias[off0];
+            }
+            dst[off0] = r0;
+            if (has1) {
+                const int64_t off1 = (int64_t) j * stride_col_dst + row1;
+                float r1 = tmp1[j];
+                if (x_bias != nullptr) {
+                    r1 += x_bias[off1];
+                }
+                dst[off1] = r1;
+            }
+        }
+    }
+}
