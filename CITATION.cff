    website: "https://github.com/demiralpdev"
version: "1.0.0"
date-released: "2026-10-25"
license: "Apache-2.0"
repository-code: "https://github.com/demiralpdev/Caphlon-Model"
keywords:
  - "Qwen 3.8 27B"
  - "GGUF"
  - "IQ2_S"
  - "llama.cpp"
  - "quantized language model"
  - "lightweight 27B"
  - "layer pruning"
  - "vocabulary reduction"
type: "software"
