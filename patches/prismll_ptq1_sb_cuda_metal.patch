+static __device__ __forceinline__ uint32_t ptq1_sb_unpack_u32(const uint32_t b, uint32_t & t4) {
+    const uint32_t q01 = (b * 0x00030001u) & 0x00FF00FFu;
+    const uint32_t t01 = ((q01 * 3u) >> 8) & 0x00030003u;
+    const uint32_t q23 = (b * 0x001B0009u) & 0x00FF00FFu;
+    const uint32_t t23 = ((q23 * 3u) >> 8) & 0x00030003u;
+    t4 = (((b * 81u) & 0xFFu) * 3u) >> 8;
+    return __byte_perm(t01, t23, 0x6420);
+}
+
+struct ptq1_sb_raw_bq {
+    uint32_t lo1;
+    uint32_t lo2;
+    uint32_t tail;
+    uint32_t off;
+    float    d_sb;
+};
+
+static __device__ __forceinline__ ptq1_sb_raw_bq ptq1_sb_prefetch_bq(const block_ptq1_sb * bq, const int lane) {
+    ptq1_sb_raw_bq res;
+    const uintptr_t  u_qs    = (uintptr_t) bq->qs;
+    const uint32_t   off     = (uint32_t) (u_qs & 3u);
+    const uint32_t * base_ap = (const uint32_t *) (u_qs - off);
+    res.off  = off;
+    res.lo1  = base_ap[lane];
+    res.lo2  = (lane < 19) ? base_ap[32 + lane] : 0u;
+    res.tail = 0u;
+    if (lane == 18) {
+        res.tail = ((uint32_t) bq->qs[200])
+                 | ((uint32_t) bq->qs[201] << 8)
+                 | ((uint32_t) bq->qs[202] << 16)
+                 | ((uint32_t) bq->qs[203] << 24);
+    } else if (lane == 19) {
+        res.tail = (uint32_t) bq->qs[204];
+    }
+    res.d_sb = ptq1_sb_sub_scale(bq, lane >> 2);
+    return res;
+}
